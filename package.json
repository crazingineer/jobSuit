{
  "name": "jobsuite",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Windows Native AI Job Automation & Career-Ops Desktop App",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"ENGINE,FRONTEND\" -c \"cyan,magenta\" \"tsx engine/server.ts --start\" \"vite\"",
    "dev:ui": "vite",
    "dev:engine": "tsx engine/server.ts --start",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "db:init": "tsx -e \"import { initDatabase } from './engine/db.ts'; initDatabase(); console.log('Database initialized successfully.');\""
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "playwright": "^1.58.2",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.2",
    "framer-motion": "^14.11.0",
    "lucide-react": "^1.70.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "yaml": "^2.9.1"
  }
}

# jobSuite Environment Configuration
# API Keys (BYOK - Bring Your Own Key)

# Google Gemini (Default recommended model: gemini-1.5-flash or gemini-2.5)
GEMINI_API_KEY=

# Anthropic Claude (e.g. claude-3-5-sonnet-20241022)
ANTHROPIC_API_KEY=

# OpenAI (e.g. gpt-4o or gpt-4o-mini)
OPENAI_API_KEY=

# Local Ollama URL (default: http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

# Chrome Remote Debugging Port for CDP (default: 9222)
CHROME_CDP_PORT=9222
